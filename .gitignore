# Versioned for history, diff and agent undo/redo. NOT a remote-backed repo:
# nothing here is ever pushed. This lane is mostly engine install state - 19.7 GB
# of binaries and model data - so the repo tracks only text config; the engine's
# flags live once in local-AI/scripts/run-ninfer-serve.ps1.

# Engine binaries, their .bak rollback copies and shipped DLLs
*.exe
*.exe.bak*
*.bak-*
*.dll

# Model weights and ninfer's own model/profile store (18.2 GB)
Models/
*.ninfer
*.metadata
*.ddi
*.obj
CMakeFiles/

# Runtime logs (request-log.jsonl alone is 134 MB)
logs/
*.log
*.jsonl

scratch/
tmp*.log

# --- fleet sensitive block (2026-11-07): secrets, keys, env, local dbs ---
.env
.env.*
*.env
!*.env.example
secrets.yaml
secrets.txt
secrets.json
*/secrets.yaml
*/secrets.txt
*/secrets.json
credentials
credentials.*
*/credentials.txt
*-credentials.json
token
tokens.json
*token*.json
.hs-*-tokens.json
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.pem
*.p12
*.keystore
*.key
cookies*.txt
*cookies.json
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
